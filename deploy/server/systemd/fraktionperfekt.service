# FraktionPerfekt (Testsystem) als systemd-Dienst – Vorlage, Schritt 01 füllt @…@ aus konfiguration.env
# und legt sie als /etc/systemd/system/@DIENST@.service ab.
# Linux-Build in /opt/@DIENST@ (framework-abhängig: gemeinsame ASP.NET-Core-Runtime aus VibeVHS-Schritt 09; mit deploy.ps1 -MitRuntime self-contained), Daten getrennt in /var/lib/@DIENST@.
# Geheimnisse und bewusste Schalter (Demodaten, Testanmeldung) stehen nur in /etc/@DIENST@/@DIENST@.env (root:@DIENST@, 0640).
[Unit]
Description=FraktionPerfekt (Testsystem)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=@DIENST@
Group=@DIENST@
WorkingDirectory=/opt/@DIENST@
ExecStart=/opt/@DIENST@/FraktionPerfekt.Web
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

Environment=ASPNETCORE_ENVIRONMENT=Testsystem
# Nur lokal: nach außen spricht ausschließlich nginx (mit Zugangspasswort)
Environment=ASPNETCORE_URLS=http://127.0.0.1:@PORT@
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=PathBase=@PFAD@
Environment=ReverseProxy__Aktiv=true
Environment=ReverseProxy__Host=@HOST@
Environment=Fraktion__OeffentlicheAdresse=https://@HOST@@PFAD@/
Environment=Mandant__Hosts__0=@HOST@
# Daten außerhalb des Programmordners: Ausrollen ersetzt nur /opt/@DIENST@, nie die Daten
Environment="ConnectionStrings__FraktionPerfekt=Data Source=/var/lib/@DIENST@/fraktionperfekt.db"
Environment=Dateiablage__Pfad=/var/lib/@DIENST@/dateien
Environment=Speicher__Schluessel=/var/lib/@DIENST@/schluessel
Environment=Speicher__Logs=/var/log/@DIENST@
EnvironmentFile=-/etc/@DIENST@/@DIENST@.env

# Neue Dateien nur für den Dienst lesbar (Datenbank, Anhänge, Data-Protection-Schlüssel)
UMask=0027

# Härtung
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/@DIENST@ /var/log/@DIENST@

[Install]
WantedBy=multi-user.target
