# /etc/fraktionperfekt/fraktionperfekt.env – bewusste Schalter und Geheimnisse (root:fraktionperfekt, 0640). NICHT ins Repository.
# Schritt 01 legt die Datei an, falls sie fehlt. Nach Änderungen: sudo systemctl restart fraktionperfekt

# ---- Sicherheitsstand (bitte lesen: docs/deploy.md) ----
# Es gibt nur die Testanmeldung (Konto wählen, ohne Passwort). Die Anwendung startet außerhalb der Entwicklung nur, wenn das hier
# ausdrücklich erlaubt ist. Erlauben NUR, solange nginx davor das Zugangspasswort verlangt (Schritt 01 richtet es ein).
#Anmeldung__TestanmeldungErlaubt=true

# Demodaten: echte Namen der Fraktion und echte Mailadressen des Vorstands, alle Vorgänge erfunden. Mit Demodaten gehen keine Mails
# hinaus (Demo-Schutz im Postausgang). Ohne Demodaten ist die Datenbank leer – und die Testanmeldung hat dann keine Konten.
#Demodaten__Anlegen=true

# KI für das Wiki (leer = aus)
#Ki__Schluessel=

# Mandanten (Vorbereitung): weitere Fraktionen mit eigener Datenbank, Auswahl über den Hostnamen
#Mandanten__0__Kennung=greven
#Mandanten__0__Hosts__0=liebler.iui.hs-osnabrueck.de
