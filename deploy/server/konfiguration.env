# Feste Werte für das FraktionPerfekt-Testsystem (wird von den Schritt-Skripten per „source“ gelesen; keine Geheimnisse!).
# Vor dem ersten Lauf prüfen bzw. anpassen (docs/deploy.md, Abschnitt „Vor dem ersten Lauf entscheiden“).
HOST="liebler.iui.hs-osnabrueck.de"   # derselbe Server und dasselbe Zertifikat wie VibeVHS
PFAD="/fraktionperfekt"               # Pfad-Basis hinter nginx (VibeVHS: /vibevhs, Node-RED: /nodered)
PORT="5081"                           # Kestrel nur auf 127.0.0.1 (VibeVHS belegt 5080)
DIENST="fraktionperfekt"              # Dienstbenutzer, systemd-Unit, Verzeichnisse
ZUGANG_BENUTZER="fraktion-test"       # Benutzer für das Zugangspasswort (nginx Basic Auth)
NGINX_SITE="/etc/nginx/sites-available/liebler.conf"   # Server-Block von VibeVHS (Schritt 03 dort)
