<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>fraktionperfekt-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FraktionPerfekt.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hilfe, Konzept und Doku in der Anwendung (aus VibeVHS übernommen): docs/**/*.md und README.md → Dokumentation/… -->
    <Content Include="..\..\docs\**\*.md" Exclude="..\..\docs\spiel*.md" Link="Dokumentation\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\README.md" Link="Dokumentation\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FraktionPerfekt.Application\FraktionPerfekt.Application.csproj" />
    <ProjectReference Include="..\FraktionPerfekt.Infrastructure\FraktionPerfekt.Infrastructure.csproj" />
    <ProjectReference Include="..\FraktionPerfekt.Adapters.Mocks\FraktionPerfekt.Adapters.Mocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Easteregg-Spiel: nur für angemeldete Personen über /spiel3d/ ausgeliefert (nicht in wwwroot; three.js, Modelle und
         LoD2-Daten liegen bei) -->
    <None Remove="Spiel3d\**" />
    <Content Remove="Spiel3d\**" />
    <Content Include="Spiel3d\**" CopyToPublishDirectory="PreserveNewest" />
    <!-- Hymne „Greven an der Ems“ für den Player im Impressum (öffentlich, siehe SpielEndpunkte.MapHymne) -->
    <Content Include="..\..\assets\*.mp3" Link="Spiel\musik\%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
