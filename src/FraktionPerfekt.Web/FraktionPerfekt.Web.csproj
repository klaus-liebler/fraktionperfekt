<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>fraktionperfekt-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FraktionPerfekt.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FraktionPerfekt.Application\FraktionPerfekt.Application.csproj" />
    <ProjectReference Include="..\FraktionPerfekt.Infrastructure\FraktionPerfekt.Infrastructure.csproj" />
    <ProjectReference Include="..\FraktionPerfekt.Adapters.Mocks\FraktionPerfekt.Adapters.Mocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Easteregg-Spiel: nur für angemeldete Personen über /spiel/ ausgeliefert (nicht in wwwroot) -->
    <None Remove="Spiel\**" />
    <Content Include="Spiel\**" Exclude="Spiel\**\*.cs" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
