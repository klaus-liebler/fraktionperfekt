@page "/presse"
@using FraktionPerfekt.Application.Gemeinsam
@using FraktionPerfekt.Application.Politik
@using FraktionPerfekt.Domain.Politik
@inject Vorgang Vorgang
@inject TimeProvider Uhr

<PageTitle>Pressearbeit · FraktionPerfekt</PageTitle>

<div class="fp-head">
    <div>
        <h1>Pressearbeit</h1>
        <p class="fp-sub">Redaktionskalender, Entwürfe mit Freigabe durch den Vorstand (vier Augen: nie die eigene Mitteilung) und Pressespiegel.</p>
    </div>
    <div class="fp-row"><RadzenButton Text="Neue Pressemitteilung" Icon="edit_note" Click="@(() => Bearbeiten(null))" /></div>
</div>

@if (meldung is not null)
{
    <div class="fp-alert @(fehler ? "fp-crit" : "fp-info")" role="status">@meldung</div>
}

@if (formular)
{
    <section class="fp-card fp-hervor">
        <h2>@(id is null ? "Neue Pressemitteilung" : "Pressemitteilung bearbeiten")</h2>
        <div class="fp-form">
            <div class="fp-field fp-grow"><label class="fp-lbl" for="p-titel">Titel</label><RadzenTextBox id="p-titel" @bind-Value="titel" @bind-Value:event="oninput" /></div>
            <div class="fp-field"><label class="fp-lbl">Geplant am</label><RadzenDatePicker TValue="DateTime?" @bind-Value="geplant" DateFormat="dd.MM.yyyy" AllowClear="true" /></div>
            <div class="fp-field"><label class="fp-lbl" for="p-thema">Thema</label><RadzenTextBox id="p-thema" @bind-Value="thema" /></div>
        </div>
        <MarkdownEditor @key="@(id ?? entwurfId)" @ref="editor" @bind-Text="text" BezugArt="@(id is null ? FraktionPerfekt.Application.Wissen.BildBesitzer.Entwurf : "Presse")"
                        BezugId="@(id ?? entwurfId)" Bezeichnung="Text der Pressemitteilung" Hoehe="360px" />
        @if (id is not null)
        {
            <p class="fp-small fp-muted">Änderungen am Text nach einer Freigabe setzen die Mitteilung auf „Entwurf“ zurück.</p>
        }
        <div class="fp-row">
            <RadzenButton Text="Speichern" Size="ButtonSize.Small" Disabled="@string.IsNullOrWhiteSpace(titel)" Click="SpeichernAsync" />
            <RadzenButton Text="Abbrechen" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => formular = false)" />
        </div>
    </section>
}

<section class="fp-card">
    <h2>Redaktionskalender</h2>
    @if (zeilen.Count == 0)
    {
        <p class="fp-leer">Noch keine Pressemitteilungen.</p>
    }
    <div class="fp-tbl">
        <table>
            <thead><tr><th>Geplant</th><th>Titel</th><th>Status</th><th>Resonanz</th><th></th></tr></thead>
            <tbody>
                @foreach (var z in zeilen)
                {
                    var m = z.Mitteilung;
                    <tr>
                        <td>@(m.GeplantAm?.ToString("ddd dd.MM.") ?? "–")</td>
                        <td><b>@m.Titel</b><br /><span class="fp-small fp-muted">@z.Autor@(m.Thema is null ? "" : $" · {m.Thema}")</span>
                            <details><summary class="fp-small">Text</summary><Markdown Text="@m.Text" /></details></td>
                        <td><StatusPille Stil="@(m.Status switch { Pressestatus.ZurFreigabe => "warn", Pressestatus.Freigegeben => "info", Pressestatus.Veroeffentlicht => "gut", _ => "neutral" })">@StatusText(m.Status)</StatusPille></td>
                        <td>@(z.Artikel == 0 ? "–" : $"{z.Artikel} Artikel")</td>
                        <td>
                            <div class="fp-row">
                                <BegruendeterButton Text="Bearbeiten" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Freigabe="@z.Bearbeiten" Click="@(() => Bearbeiten(m))" />
                                @if (m.Status == Pressestatus.Entwurf)
                                {
                                    <BegruendeterButton Text="Zur Freigabe" Size="ButtonSize.ExtraSmall" Freigabe="@z.Einreichen" Click="@(() => AusfuehrenAsync(s => s.ZurFreigabeAsync(m.Id), "Zur Freigabe beim Vorstand."))" />
                                }
                                @if (m.Status == Pressestatus.ZurFreigabe)
                                {
                                    <BegruendeterButton Text="Freigeben" Size="ButtonSize.ExtraSmall" Freigabe="@z.Freigeben" Click="@(() => AusfuehrenAsync(s => s.EntscheidenAsync(m.Id, true), "Freigegeben."))" />
                                    <BegruendeterButton Text="Zurückweisen" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Freigabe="@z.Freigeben" Click="@(() => AusfuehrenAsync(s => s.EntscheidenAsync(m.Id, false), "Zurückgewiesen."))" />
                                }
                                @if (m.Status == Pressestatus.Freigegeben)
                                {
                                    <BegruendeterButton Text="Als versendet markieren" Size="ButtonSize.ExtraSmall" Freigabe="@z.Veroeffentlichen" Click="@(() => AusfuehrenAsync(s => s.VeroeffentlichenAsync(m.Id), "Als versendet markiert."))" />
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="fp-card">
    <h2>Pressespiegel</h2>
    <div class="fp-tbl">
        <table>
            <thead><tr><th>Datum</th><th>Medium</th><th>Artikel</th><th>Tonlage</th></tr></thead>
            <tbody>
                @foreach (var s in spiegel)
                {
                    <tr>
                        <td>@s.Artikel.Datum.ToString("dd.MM.yyyy")</td>
                        <td>@s.Artikel.Medium</td>
                        <td>@if (s.Artikel.Link is { } l) { <a href="@l" target="_blank" rel="noopener noreferrer">@s.Artikel.Titel</a> } else { @s.Artikel.Titel }
                            @if (s.Artikel.Zusammenfassung is not null) { <br /><span class="fp-small">@s.Artikel.Zusammenfassung</span> }
                            @if (s.Mitteilung is not null) { <br /><span class="fp-small fp-muted">zu: @s.Mitteilung</span> }</td>
                        <td><StatusPille Stil="@(s.Artikel.Tonlage switch { Tonlage.Positiv => "gut", Tonlage.Kritisch => "krit", _ => "neutral" })">@s.Artikel.Tonlage</StatusPille></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <details>
        <summary>Artikel erfassen</summary>
        <div class="fp-form">
            <div class="fp-field"><label class="fp-lbl" for="s-medium">Medium</label><RadzenTextBox id="s-medium" @bind-Value="medium" @bind-Value:event="oninput" /></div>
            <div class="fp-field fp-grow"><label class="fp-lbl" for="s-titel">Überschrift</label><RadzenTextBox id="s-titel" @bind-Value="artikelTitel" @bind-Value:event="oninput" /></div>
            <div class="fp-field"><label class="fp-lbl">Datum</label><RadzenDatePicker TValue="DateTime" @bind-Value="artikelDatum" DateFormat="dd.MM.yyyy" /></div>
            <div class="fp-field fp-grow"><label class="fp-lbl" for="s-link">Link</label><RadzenTextBox id="s-link" @bind-Value="link" /></div>
            <div class="fp-field"><label class="fp-lbl">Tonlage</label><RadzenDropDown TValue="Tonlage" @bind-Value="tonlage" Data="@(Enum.GetValues<Tonlage>())" /></div>
            <div class="fp-field"><label class="fp-lbl">Zu Mitteilung</label><RadzenDropDown TValue="Guid?" @bind-Value="bezug" AllowClear="true" Data="@zeilen.Select(z => z.Mitteilung).ToList()" TextProperty="Titel" ValueProperty="Id" /></div>
            <div class="fp-field fp-grow"><label class="fp-lbl" for="s-zus">Kurz zusammengefasst</label><RadzenTextBox id="s-zus" @bind-Value="zusammenfassung" /></div>
        </div>
        <RadzenButton Text="Erfassen" Size="ButtonSize.Small" Disabled="@(string.IsNullOrWhiteSpace(medium) || string.IsNullOrWhiteSpace(artikelTitel))" Click="ArtikelAsync" />
    </details>
</section>

@code {
    private IReadOnlyList<PresseZeile> zeilen = [];
    private IReadOnlyList<SpiegelZeile> spiegel = [];
    private bool formular;
    private Guid? id;
    private MarkdownEditor? editor;
    private readonly Guid entwurfId = Guid.NewGuid();
    private string? titel, text, thema;
    private DateTime? geplant;
    private string? medium, artikelTitel, link, zusammenfassung;
    private DateTime artikelDatum;
    private Tonlage tonlage = Tonlage.Neutral;
    private Guid? bezug;
    private string? meldung;
    private bool fehler;

    private static string StatusText(Pressestatus s) => s switch
    {
        Pressestatus.ZurFreigabe => "zur Freigabe",
        Pressestatus.Freigegeben => "freigegeben",
        Pressestatus.Veroeffentlicht => "versendet",
        _ => "Entwurf",
    };

    protected override async Task OnInitializedAsync()
    {
        artikelDatum = Ortszeit.Heute(Uhr).ToDateTime(TimeOnly.MinValue);
        await LadenAsync();
    }

    private async Task LadenAsync()
    {
        zeilen = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<PresseDienst>().MitteilungenAsync());
        spiegel = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<PresseDienst>().SpiegelAsync());
    }

    private void Bearbeiten(Pressemitteilung? m)
    {
        formular = true;
        (id, titel, text, thema, geplant) = (m?.Id, m?.Titel, m?.Text, m?.Thema, m?.GeplantAm?.ToDateTime(TimeOnly.MinValue));
    }

    private async Task SpeichernAsync()
    {
        if (editor is not null)
        {
            text = await editor.AktuellerTextAsync();
        }

        await AusfuehrenAsync(s => s.SpeichernAsync(id, titel!, text ?? "", geplant is { } g ? DateOnly.FromDateTime(g) : null, thema), "Gespeichert.");
        formular = fehler;
    }

    private async Task ArtikelAsync()
    {
        await AusfuehrenAsync(s => s.ArtikelErfassenAsync(medium!, artikelTitel!, DateOnly.FromDateTime(artikelDatum), link, zusammenfassung, null, tonlage, bezug),
            "Im Pressespiegel erfasst.");
        if (!fehler)
        {
            (medium, artikelTitel, link, zusammenfassung, bezug) = (null, null, null, null, null);
        }
    }

    private async Task AusfuehrenAsync(Func<PresseDienst, Task> aktion, string erfolg)
    {
        try
        {
            await Vorgang.AusfuehrenAsync(d => aktion(d.GetRequiredService<PresseDienst>()));
            (meldung, fehler) = (erfolg, false);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            (meldung, fehler) = (ex.Message, true);
        }

        await LadenAsync();
    }
}
