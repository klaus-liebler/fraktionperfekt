@page "/wahlkampf"
@using FraktionPerfekt.Application.Gemeinsam
@using FraktionPerfekt.Application.Wahlkampf
@using FraktionPerfekt.Domain.Wahlkampf
@inject Vorgang Vorgang
@inject IJSRuntime JS

<PageTitle>Wahlkampf · FraktionPerfekt</PageTitle>

<div class="fp-head">
    <div>
        <h1>Wahlkampf</h1>
        <p class="fp-sub">Plakatkarte, Gebiete und Infostand-Schichten. Plakate erfasst man am besten am Handy (Foto und Standort): <a href="handy/plakat">Handy-Ansicht „Plakate“</a>.</p>
    </div>
</div>

@if (meldung is not null)
{
    <div class="fp-alert @(fehler ? "fp-crit" : "fp-info")" role="status">@meldung</div>
}

<div class="fp-chips" role="tablist">
    @foreach (var (wert, text) in new[] { ("karte", "Karte"), ("abhaengen", "Abhängliste"), ("gebiete", "Gebiete"), ("schichten", "Infostand-Schichten") })
    {
        <button class="fp-chip @(ansicht == wert ? "on" : null)" role="tab" aria-selected="@(ansicht == wert)" @onclick="@(() => WechselnAsync(wert))">@text</button>
    }
</div>

@if (ansicht == "karte")
{
    <div class="fp-kpis">
        @foreach (var s in Enum.GetValues<Plakatstatus>())
        {
            <div class="fp-kpi"><div class="fp-kpi-lbl"><span class="fp-punkt" style="background:@Farbe(s)"></span> @StatusText(s)</div><div class="fp-kpi-val">@plakate.Count(p => p.Plakat.Status == s)</div></div>
        }
    </div>
    <section class="fp-card">
        <div id="plakatkarte" class="fp-karte" role="img" aria-label="Karte der Plakatstandorte"></div>
        <p class="fp-small fp-muted">Kartendaten © OpenStreetMap-Mitwirkende. Klick auf einen Punkt zeigt Standort und Foto.</p>
    </section>
    <section class="fp-card">
        <h2>Plakate <span class="fp-zahl">@plakate.Count</span></h2>
        <div class="fp-tbl">
            <table>
                <thead><tr><th>Standort</th><th>Art</th><th>Status</th><th>Zuletzt</th><th></th></tr></thead>
                <tbody>
                    @foreach (var z in plakate)
                    {
                        <tr>
                            <td>@z.Plakat.Standort@if (z.Plakat.Motiv is not null) { <span class="fp-small fp-muted"> · @z.Plakat.Motiv</span> }
                                @if (z.Plakat.FotoSchluessel is not null) { <text> · </text><a href="wahlkampf/plakat/@z.Plakat.Id/foto" target="_blank">Foto</a> }</td>
                            <td>@z.Plakat.Art</td>
                            <td><span class="fp-punkt" style="background:@Farbe(z.Plakat.Status)"></span> @StatusText(z.Plakat.Status)</td>
                            <td class="fp-small">@Ortszeit.AlsOrtszeit(z.Plakat.GeaendertAm).ToString("dd.MM. HH:mm")</td>
                            <td>
                                <RadzenDropDown TValue="Plakatstatus" Value="@z.Plakat.Status" Data="@(Enum.GetValues<Plakatstatus>())" Style="width:140px" aria-label="Status ändern"
                                                Change="@(v => AusfuehrenAsync(s => s.StatusSetzenAsync(z.Plakat.Id, (Plakatstatus)v), "Status geändert."))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else if (ansicht == "abhaengen" && abhaengliste is not null)
{
    <section class="fp-card @(abhaengliste.NachDerWahl ? "fp-hervor" : null)">
        <h2>Abhängliste <span class="fp-zahl">@abhaengliste.Plakate.Count</span></h2>
        <p>
            @if (abhaengliste.Wahltag is { } w)
            {
                <text>Wahltag @w.ToString("dd.MM.yyyy"); alle Plakate müssen bis <b>@abhaengliste.FristBis?.ToString("dd.MM.yyyy")</b> weg sein.</text>
            }
            else
            {
                <text>Kein Wahltag eingestellt (Fraktion:Wahltag).</text>
            }
            Am Handy sortiert die Liste nach Entfernung: <a href="handy/plakat?abhaengen=1">Handy-Abhängliste</a>.
        </p>
        <ul class="fp-kompakt">
            @foreach (var z in abhaengliste.Plakate)
            {
                <li>@z.Plakat.Standort · @z.Plakat.Art · @StatusText(z.Plakat.Status)
                    <button class="fp-linkbutton fp-small" @onclick="@(() => AusfuehrenAsync(s => s.StatusSetzenAsync(z.Plakat.Id, Plakatstatus.Abgehaengt), "Abgehängt."))">abgehängt</button></li>
            }
        </ul>
    </section>
}
else if (ansicht == "gebiete")
{
    <section class="fp-card">
        <h2>Gebiete</h2>
        <div class="fp-tbl">
            <table>
                <thead><tr><th>Gebiet</th><th>Art</th><th>Zugeteilt</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var z in gebiete)
                    {
                        var g = z.Gebiet;
                        <tr>
                            <td><b>@g.Name</b>@if (g.Beschreibung is not null) { <br /><span class="fp-small">@g.Beschreibung</span> }</td>
                            <td>@g.Art</td>
                            <td>
                                @if (z.Zuteilen.Erlaubt)
                                {
                                    <RadzenDropDown TValue="Guid?" Value="@g.ZugeteiltPersonId" Data="@personen" TextProperty="Anzeigename" ValueProperty="Id" AllowClear="true" Style="width:190px"
                                                    aria-label="Zuteilen" Change="@(v => AusfuehrenAsync(s => s.ZuteilenAsync(g.Id, (Guid?)v), "Zugeteilt."))" />
                                }
                                else
                                {
                                    @(z.Zugeteilt ?? "–")
                                }
                            </td>
                            <td><StatusPille Stil="@(g.Status == Gebietsstatus.Erledigt ? "gut" : g.Status == Gebietsstatus.Zugeteilt ? "info" : "neutral")">@g.Status</StatusPille></td>
                            <td><BegruendeterButton Text="Erledigt" Size="ButtonSize.ExtraSmall" Freigabe="@z.Erledigen" Click="@(() => AusfuehrenAsync(s => s.GebietErledigenAsync(g.Id, null), "Abgehakt."))" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (steuern)
        {
            <details>
                <summary>Gebiet anlegen</summary>
                <div class="fp-form">
                    <div class="fp-field"><label class="fp-lbl" for="g-name">Name</label><RadzenTextBox id="g-name" @bind-Value="gebietName" Immediate="true" /></div>
                    <div class="fp-field"><label class="fp-lbl">Art</label><RadzenDropDown TValue="Gebietsart" @bind-Value="gebietArt" Data="@(Enum.GetValues<Gebietsart>())" /></div>
                    <div class="fp-field fp-grow"><label class="fp-lbl" for="g-beschr">Straßen / Beschreibung</label><RadzenTextBox id="g-beschr" @bind-Value="gebietBeschreibung" /></div>
                </div>
                <RadzenButton Text="Anlegen" Size="ButtonSize.Small" Disabled="@string.IsNullOrWhiteSpace(gebietName)"
                              Click="@(() => AusfuehrenAsync(s => s.GebietAnlegenAsync(gebietName!, gebietArt, gebietBeschreibung, null, null), "Gebiet angelegt."))" />
            </details>
        }
    </section>
}
else if (ansicht == "schichten")
{
    <section class="fp-card">
        <h2>Infostand-Schichten</h2>
        @if (schichten.Count == 0)
        {
            <p class="fp-leer">Keine kommenden Schichten.</p>
        }
        @foreach (var z in schichten)
        {
            <div class="fp-anfrage">
                <span><b>@z.Schicht.Von.ToString("ddd dd.MM., HH:mm")–@z.Schicht.Bis.ToString("HH:mm")</b> · @z.Schicht.Ort ·
                    @(z.Frei > 0 ? $"{z.Frei} von {z.Schicht.Plaetze} frei" : "voll")@(z.Namen.Count > 0 ? $" · {string.Join(", ", z.Namen)}" : "")</span>
                <BegruendeterButton Text="@(z.Ich ? "Austragen" : "Ich bin dabei")" Size="ButtonSize.Small" ButtonStyle="@(z.Ich ? ButtonStyle.Light : ButtonStyle.Primary)"
                                    Freigabe="@z.Eintragen" Click="@(() => AusfuehrenAsync(s => s.EintragenAsync(z.Schicht.Id), z.Ich ? "Ausgetragen." : "Eingetragen."))" />
            </div>
        }
        @if (steuern)
        {
            <details>
                <summary>Schicht anlegen</summary>
                <div class="fp-form">
                    <div class="fp-field"><label class="fp-lbl" for="s-ort">Ort</label><RadzenTextBox id="s-ort" @bind-Value="schichtOrt" Immediate="true" /></div>
                    <div class="fp-field"><label class="fp-lbl">Von</label><RadzenDatePicker TValue="DateTime" @bind-Value="schichtVon" ShowTime="true" DateFormat="dd.MM.yyyy HH:mm" /></div>
                    <div class="fp-field"><label class="fp-lbl">Bis</label><RadzenDatePicker TValue="DateTime" @bind-Value="schichtBis" ShowTime="true" DateFormat="dd.MM.yyyy HH:mm" /></div>
                    <div class="fp-field"><label class="fp-lbl">Plätze</label><RadzenNumeric TValue="int" @bind-Value="schichtPlaetze" Min="1" Max="20" Style="width:90px" /></div>
                </div>
                <RadzenButton Text="Anlegen" Size="ButtonSize.Small" Disabled="@string.IsNullOrWhiteSpace(schichtOrt)"
                              Click="@(() => AusfuehrenAsync(s => s.SchichtAnlegenAsync(schichtOrt!, schichtVon, schichtBis, schichtPlaetze, null), "Schicht angelegt."))" />
            </details>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "ansicht")]
    private string? AnsichtParameter { get; set; }

    private string ansicht = "karte";
    private IReadOnlyList<PlakatZeile> plakate = [];
    private Abhaengliste? abhaengliste;
    private IReadOnlyList<GebietZeile> gebiete = [];
    private IReadOnlyList<SchichtZeile> schichten = [];
    private IReadOnlyList<Person> personen = [];
    private bool steuern;
    private bool karteNeu;
    private string? meldung;
    private bool fehler;
    private string? gebietName, gebietBeschreibung, schichtOrt;
    private Gebietsart gebietArt = Gebietsart.Plakatieren;
    private DateTime schichtVon = DateTime.Today.AddDays(2).AddHours(10);
    private DateTime schichtBis = DateTime.Today.AddDays(2).AddHours(12);
    private int schichtPlaetze = 3;

    private static string Farbe(Plakatstatus s) => s switch
    {
        Plakatstatus.Geplant => "#9aa5b1",
        Plakatstatus.Haengt => "#2e8540",
        Plakatstatus.Beschaedigt => "#e8a317",
        _ => "#c0392b",
    };

    private static string StatusText(Plakatstatus s) => s switch
    {
        Plakatstatus.Geplant => "geplant",
        Plakatstatus.Haengt => "hängt",
        Plakatstatus.Beschaedigt => "beschädigt",
        _ => "abgehängt",
    };

    protected override async Task OnInitializedAsync()
    {
        ansicht = AnsichtParameter ?? "karte";
        steuern = Rechte.WahlkampfSteuern((await Vorgang.BenutzerAsync()).Rolle).Erlaubt;
        personen = (await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IStammdatenSpeicher>().PersonenAsync())).OrderBy(p => p.Nachname).ToList();
        await LadenAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ansicht == "karte" && (firstRender || karteNeu) && RendererInfo.IsInteractive)
        {
            karteNeu = false;
            var daten = new
            {
                mitte = new[] { 52.0917, 7.6083 },
                zoom = 14,
                punkte = plakate.Select(z => new
                {
                    breite = z.Plakat.Breite,
                    laenge = z.Plakat.Laenge,
                    farbe = Farbe(z.Plakat.Status),
                    titel = $"{z.Plakat.Standort} – {StatusText(z.Plakat.Status)} ({z.Plakat.Art})",
                    link = z.Plakat.FotoSchluessel is null ? null : $"wahlkampf/plakat/{z.Plakat.Id}/foto",
                }),
            };
            try
            {
                await JS.InvokeVoidAsync("fpKarte.zeigen", "plakatkarte", daten);
            }
            catch (JSException)
            {
                // Karte ist Zusatz: Ohne Leaflet bleibt die Liste nutzbar.
            }
            catch (JSDisconnectedException)
            {
                // Verbindung beendet.
            }
        }
    }

    private async Task WechselnAsync(string wert)
    {
        ansicht = wert;
        await LadenAsync();
    }

    private async Task LadenAsync()
    {
        plakate = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<WahlkampfDienst>().PlakateAsync());
        abhaengliste = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<WahlkampfDienst>().AbhaenglisteAsync());
        gebiete = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<WahlkampfDienst>().GebieteAsync());
        schichten = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<WahlkampfDienst>().SchichtenAsync());
        karteNeu = true;
    }

    private async Task AusfuehrenAsync(Func<WahlkampfDienst, Task> aktion, string erfolg)
    {
        try
        {
            await Vorgang.AusfuehrenAsync(d => aktion(d.GetRequiredService<WahlkampfDienst>()));
            (meldung, fehler) = (erfolg, false);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            (meldung, fehler) = (ex.Message, true);
        }

        await LadenAsync();
    }
}
