@page "/betrieb"
@using FraktionPerfekt.Application.Betrieb
@using FraktionPerfekt.Application.Gemeinsam
@inject Vorgang Vorgang

<PageTitle>Betrieb · FraktionPerfekt</PageTitle>

<div class="fp-head">
    <div>
        <h1>Betrieb und Sicherung</h1>
        <p class="fp-sub">Tägliche SQLite-Online-Sicherung (01:30 Uhr) mit SHA-256 und automatischem Wiederherstellungstest. Ablauf im Notfall: docs/betrieb.md.</p>
    </div>
    <div class="fp-row">
        <BegruendeterButton Text="Jetzt sichern" Icon="backup" Freigabe="@Rechte.BetriebSteuern(benutzer?.Rolle)" Click="SichernAsync" IsBusy="laeuft" />
    </div>
</div>

@if (meldung is not null)
{
    <div class="fp-alert @(fehler ? "fp-crit" : "fp-info")" role="status">@meldung</div>
}

@if (Rechte.BetriebSteuern(benutzer?.Rolle) is { Erlaubt: false } nein)
{
    <div class="fp-alert fp-warn">@nein.Begruendung</div>
}
else
{
    <section class="fp-card fp-tbl">
        @if (sicherungen.Count == 0)
        {
            <p class="fp-muted">Noch keine Sicherung vorhanden.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Zeitpunkt</th><th>Datei</th><th>Größe</th><th>Wiederherstellungstest</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in sicherungen)
                    {
                        <tr>
                            <td>@Ortszeit.AlsOrtszeit(s.Am).ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="fp-mono" title="SHA-256 @s.Sha256">@s.Datei</td>
                            <td>@(s.Bytes / 1024) KB</td>
                            <td>
                                @if (s.Wiederherstellbar == true)
                                {
                                    <StatusPille Stil="gut">ok</StatusPille>
                                }
                                else
                                {
                                    <StatusPille Stil="krit">nicht ok</StatusPille>
                                }
                                <span class="fp-small fp-muted">@s.Pruefergebnis</span>
                            </td>
                            <td><RadzenButton Text="Erneut prüfen" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => PruefenAsync(s.Datei))" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="fp-card" aria-labelledby="h-impressum">
        <div class="fp-head"><h2 id="h-impressum">Impressum</h2>
            <span class="fp-small fp-muted">öffentlich unter <a href="impressum" target="_blank">/impressum</a>, verlinkt in den Fußzeilen; Markdown (z. B. **fett**, Leerzeile = neuer Absatz)</span></div>
        @if (impressumGespeichert is null)
        {
            <div class="fp-alert fp-warn">Noch kein Impressum gepflegt – die Seite zeigt einen Platzhalter. Die Vorlage unten bitte vollständig anpassen.</div>
        }
        <textarea class="fp-textarea fp-mono" rows="12" maxlength="@FraktionPerfekt.Domain.Dokumentation.Impressum.MaxZeichen" aria-label="Impressum (Markdown)"
                  @bind="impressum" @bind:event="oninput"></textarea>
        <div class="fp-row">
            <BegruendeterButton Text="Impressum speichern" Icon="save" Click="ImpressumSpeichernAsync"
                                Freigabe="@(Rechte.ImpressumPflegen(benutzer?.Rolle).Und(() => impressum == (impressumGespeichert ?? ImpressumVorlage) ? Freigabe.Nein("Bitte zuerst den Text anpassen – noch keine Änderung.") : Freigabe.Ja))" />
            <span class="fp-small fp-muted">@(impressum?.Length ?? 0) / @FraktionPerfekt.Domain.Dokumentation.Impressum.MaxZeichen Zeichen</span>
        </div>
    </section>
}

@code {
    private Benutzer? benutzer;
    private IReadOnlyList<Sicherungseintrag> sicherungen = [];
    private string? meldung;
    private bool fehler;
    private bool laeuft;
    private string? impressum;
    private string? impressumGespeichert;

    /// <summary>Vorlage für ein leeres Impressum (§ 5 DDG); wird nicht gespeichert, solange sie unverändert ist.</summary>
    private static readonly string ImpressumVorlage = """
        **[Name der Fraktion]** im Rat der Stadt [ … ]
        [Straße Hausnummer]
        [PLZ Ort]

        **Vertreten durch:** [Fraktionsvorsitz, Name]

        **Kontakt:** Telefon [ … ] · E-Mail [ … ]

        **Verantwortlich für den Inhalt:** [Name, Anschrift]

        **Betrieb des Systems:** [Betreiber, Kontakt]
        """;

    protected override async Task OnInitializedAsync()
    {
        benutzer = await Vorgang.BenutzerAsync();
        await LadenAsync();
        impressumGespeichert = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<FraktionPerfekt.Application.Dokumentation.DokumentationDienst>().ImpressumAsync());
        impressum = impressumGespeichert ?? ImpressumVorlage;
    }

    private async Task LadenAsync()
    {
        if (Rechte.BetriebSteuern(benutzer?.Rolle).Erlaubt)
        {
            sicherungen = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<ISicherung>().ListeAsync());
        }
    }

    private async Task SichernAsync()
    {
        laeuft = true;
        try
        {
            var e = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<ISicherung>().SichernAsync());
            (meldung, fehler) = ($"Gesichert: {e.Datei}. Wiederherstellungstest: {e.Pruefergebnis}", e.Wiederherstellbar != true);
        }
        catch (InvalidOperationException ex)
        {
            (meldung, fehler) = (ex.Message, true);
        }

        laeuft = false;
        await LadenAsync();
    }

    private async Task ImpressumSpeichernAsync()
    {
        try
        {
            await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<FraktionPerfekt.Application.Dokumentation.DokumentationDienst>()
                .ImpressumSetzenAsync(impressum == ImpressumVorlage ? null : impressum));
            impressumGespeichert = impressum == ImpressumVorlage ? null : impressum?.Trim();
            (meldung, fehler) = ("Impressum gespeichert – öffentlich unter /impressum.", false);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            (meldung, fehler) = (ex.Message, true);
        }
    }

    private async Task PruefenAsync(string datei)
    {
        var e = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<ISicherung>().PruefenAsync(datei));
        (meldung, fehler) = ($"{e.Datei}: {e.Pruefergebnis}", e.Wiederherstellbar != true);
        await LadenAsync();
    }
}
