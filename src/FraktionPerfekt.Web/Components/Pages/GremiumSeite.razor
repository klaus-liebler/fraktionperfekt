@page "/gremien/{Id:guid}"
@using FraktionPerfekt.Application.Gemeinsam
@using FraktionPerfekt.Application.Stammdaten
@using FraktionPerfekt.Domain.Gemeinsam
@using FraktionPerfekt.Domain.Gremien
@inject Vorgang Vorgang
@inject TimeProvider Uhr

<PageTitle>Gremium · FraktionPerfekt</PageTitle>

<a class="fp-zurueck" href="gremien">← Gremien und Mandate</a>

@if (detail is null)
{
    <p class="fp-muted">Lade …</p>
}
else
{
    <div class="fp-head">
        <div>
            <h1>@detail.Gremium.Name</h1>
            <p class="fp-sub">@detail.Gremium.Art · @(detail.Gremium.AusDemRis ? "aus dem Ratsinformationssystem" : "fraktionsintern")</p>
        </div>
        <a class="fp-btn" href="kalender">Sitzungen im Kalender</a>
    </div>

    @if (meldung is not null)
    {
        <div class="fp-alert fp-info" role="status">@meldung</div>
    }

    <div class="fp-split">
        <section class="fp-card">
            <h2>Ordentliche Mitglieder <span class="fp-zahl">@detail.Ordentliche.Count</span></h2>
            <div class="fp-list">
                @foreach (var m in detail.Ordentliche)
                {
                    <div><span class="fp-grow"><a href="personen/@m.PersonId">@m.Name</a></span><Verlauf Versionen="m.Verlauf" /></div>
                }
            </div>
        </section>
        <section class="fp-card">
            <h2>Stellvertretungen in Rangfolge <span class="fp-zahl">@detail.Stellvertretungen.Count</span></h2>
            <p class="fp-small fp-muted">Bei Abwesenheit werden sie in dieser Reihenfolge gefragt. Änderungen gelten ab einem Datum; frühere Sitzungen behalten die alte Reihenfolge.</p>
            <div class="fp-list">
                @foreach (var m in detail.Stellvertretungen)
                {
                    <div>
                        <span class="fp-zeit"><b>Rang @m.Rang</b></span>
                        <span class="fp-grow"><a href="personen/@m.PersonId">@m.Name</a></span>
                        <Verlauf Versionen="m.Verlauf" />
                        @if (bearbeiten == m.MitgliedschaftId)
                        {
                            <RadzenNumeric TValue="int" @bind-Value="neuerRang" Min="1" Style="width:80px" aria-label="Neuer Rang" />
                            <RadzenDatePicker TValue="DateTime" @bind-Value="ab" DateFormat="dd.MM.yyyy" aria-label="Gültig ab" />
                            <RadzenButton Text="Speichern" Size="ButtonSize.Small" Click="@(() => RangSpeichernAsync(m.MitgliedschaftId))" />
                        }
                        else
                        {
                            <BegruendeterButton Text="Rang ändern" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Freigabe="@Rechte.StammdatenPflegen(benutzer?.Rolle)"
                                                Click="@(() => { bearbeiten = m.MitgliedschaftId; neuerRang = m.Rang ?? 1; })" />
                        }
                    </div>
                }
            </div>
        </section>
    </div>
    @if (detail.Ehemalige.Count > 0)
    {
        <details class="fp-card">
            <summary>Ehemalige Mitglieder (@detail.Ehemalige.Count)</summary>
            <div class="fp-list">
                @foreach (var m in detail.Ehemalige)
                {
                    <div><span class="fp-grow">@m.Name</span><Verlauf Versionen="m.Verlauf" /></div>
                }
            </div>
        </details>
    }
    <p class="fp-small fp-muted">
        Neue Mitglieder: @(StammdatenDienst.MitgliedschaftPflegen(benutzer?.Rolle, detail.Gremium) is { Erlaubt: false } nein ? nein.Begruendung : "über die Personenseite (folgt) oder den RIS-Abgleich.")
    </p>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Benutzer? benutzer;
    private GremiumDetail? detail;
    private Guid? bearbeiten;
    private int neuerRang = 1;
    private DateTime ab;
    private string? meldung;

    protected override async Task OnParametersSetAsync()
    {
        benutzer = await Vorgang.BenutzerAsync();
        ab = Ortszeit.Heute(Uhr).ToDateTime(TimeOnly.MinValue);
        await LadenAsync();
    }

    private async Task LadenAsync() => detail = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<StammdatenDienst>().GremiumAsync(Id));

    private async Task RangSpeichernAsync(Guid mitgliedschaftId)
    {
        try
        {
            await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<StammdatenDienst>()
                .RangAendernAsync(mitgliedschaftId, neuerRang, DateOnly.FromDateTime(ab), "Rangfolge in der Fraktion geändert"));
            meldung = $"Rang ab {ab:dd.MM.yyyy} geändert. Hinweis: Ränge dürfen vorübergehend doppelt sein; bitte auch die anderen anpassen.";
            bearbeiten = null;
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            meldung = ex.Message;
        }

        await LadenAsync();
    }
}
