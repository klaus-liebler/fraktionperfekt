@page "/abstimmungen/{Id:guid}"
@using FraktionPerfekt.Application.Abstimmungen
@using FraktionPerfekt.Application.Gemeinsam
@using FraktionPerfekt.Domain.Abstimmungen
@inject Vorgang Vorgang

<PageTitle>Abstimmung · FraktionPerfekt</PageTitle>

<a class="fp-zurueck" href="abstimmungen">← Abstimmungen</a>

@if (d is null)
{
    <p class="fp-muted">Lade …</p>
}
else
{
    <div class="fp-head">
        <div>
            <h1>@d.Umfrage.Titel</h1>
            <p class="fp-sub">Frist @Ortszeit.AlsOrtszeit(d.Umfrage.Frist).ToString("dddd, dd.MM.yyyy, HH:mm") Uhr@(d.Umfrage.QuorumProzent > 0 ? $" · Quorum {d.Umfrage.QuorumProzent} %" : "")
                @(d.Umfrage.Beschreibung is null ? "" : $" · {d.Umfrage.Beschreibung}")</p>
        </div>
        <BegruendeterButton Text="Jetzt abschließen" ButtonStyle="ButtonStyle.Light" Freigabe="@d.Abschliessen" Click="AbschliessenAsync" />
    </div>

    @if (meldung is not null)
    {
        <div class="fp-alert @(fehler ? "fp-crit" : "fp-info")" role="status">@meldung</div>
    }

    @if (d.NaechsteSchritte.Count > 0)
    {
        <NaechsteSchritte Schritte="d.NaechsteSchritte" />
    }

    <div class="fp-split">
        <section class="fp-card">
            <h2>@(d.Umfrage.Mehrfachauswahl ? "Auswahl (mehrere möglich)" : "Stimme")</h2>
            @foreach (var o in d.Optionen)
            {
                <label class="fp-option @(auswahl.Contains(o.Id) ? "sel" : null)">
                    <input type="@(d.Umfrage.Mehrfachauswahl ? "checkbox" : "radio")" name="wahl" checked="@auswahl.Contains(o.Id)" disabled="@(!d.Abstimmen.Erlaubt)"
                           @onchange="@(() => Umschalten(o.Id))" />
                    <span class="fp-grow">@o.Text</span>
                </label>
            }
            <BegruendeterButton Text="@(d.MeineStimmen.Count > 0 ? "Stimme ändern" : "Abstimmen")" Icon="how_to_vote"
                                Freigabe="@d.Abstimmen.Und(() => auswahl.Count == 0 ? Freigabe.Nein("Bitte eine Antwort wählen.") : Freigabe.Ja)" Click="AbstimmenAsync" />
            <p class="fp-small fp-muted">Stimmen sind bis zur Frist änderbar. Im Protokoll steht nur, dass abgestimmt wurde, nicht wie.</p>
        </section>
        <section class="fp-card">
            <h2>Zwischenstand</h2>
            <p>@d.Ergebnis.Text</p>
            <div class="fp-balken">
                @{ var max = Math.Max(1, d.Ergebnis.Optionen.Max(o => o.Stimmen)); }
                @foreach (var o in d.Ergebnis.Optionen)
                {
                    <Balken Name="@o.Text" Wert="@o.Stimmen" Maximum="@max" Anzeige="@o.Stimmen.ToString("N0")" />
                }
            </div>
            <p class="fp-small fp-muted">Abgestimmt haben: @string.Join(", ", d.Abgestimmt)</p>
        </section>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UmfrageDetail? d;
    private HashSet<Guid> auswahl = [];
    private string? meldung;
    private bool fehler;

    protected override async Task OnParametersSetAsync() => await LadenAsync();

    private async Task LadenAsync()
    {
        d = await Vorgang.AusfuehrenAsync(s => s.GetRequiredService<UmfrageDienst>().DetailAsync(Id));
        auswahl = d?.MeineStimmen.ToHashSet() ?? [];
    }

    private void Umschalten(Guid option)
    {
        if (d is { Umfrage.Mehrfachauswahl: false })
        {
            auswahl = [option];
        }
        else if (!auswahl.Remove(option))
        {
            auswahl.Add(option);
        }
    }

    private async Task AbstimmenAsync()
    {
        try
        {
            var gewaehlt = auswahl.ToList();
            await Vorgang.AusfuehrenAsync(s => s.GetRequiredService<UmfrageDienst>().AbstimmenAsync(Id, gewaehlt));
            (meldung, fehler) = ("Stimme gespeichert.", false);
        }
        catch (InvalidOperationException ex)
        {
            (meldung, fehler) = (ex.Message, true);
        }

        await LadenAsync();
    }

    private async Task AbschliessenAsync()
    {
        try
        {
            var e = await Vorgang.AusfuehrenAsync(s => s.GetRequiredService<UmfrageDienst>().AbschliessenAsync(Id));
            (meldung, fehler) = ($"Abgeschlossen: {e.Text}", false);
        }
        catch (InvalidOperationException ex)
        {
            (meldung, fehler) = (ex.Message, true);
        }

        await LadenAsync();
    }
}
