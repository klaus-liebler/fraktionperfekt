@page "/Error"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout LeeresLayout
@using System.Diagnostics

<PageTitle>Fehler · FraktionPerfekt</PageTitle>

<div class="fp-login">
    <h1>Es ist ein Fehler aufgetreten</h1>
    <p>Bitte versuchen Sie es noch einmal. Bleibt der Fehler, nennen Sie der Geschäftsführung diese Kennung:</p>
    <p><code>@RequestId</code></p>
    <a href="">Zur Startseite</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId => Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
