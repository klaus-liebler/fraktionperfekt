@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject FraktionPerfekt.Application.Gemeinsam.Betriebsart Betriebsart

<RadzenComponents />

<div class="fp-app">
    <aside class="fp-side">
        <Marke />
        <nav class="fp-nav" aria-label="Hauptnavigation">
            @foreach (var gruppe in Navigationspunkte.GroupBy(n => n.Gruppe))
            {
                <div class="fp-grp">@gruppe.Key</div>
                @foreach (var punkt in gruppe)
                {
                    @if (Gesperrt(punkt) is { } grund)
                    {
                        <span class="fp-why fp-nav-off" tabindex="0" data-why="@grund" aria-disabled="true">@punkt.Titel</span>
                    }
                    else
                    {
                        <NavLink href="@punkt.Ziel" Match="@(punkt.Ziel == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" ActiveClass="on">@punkt.Titel</NavLink>
                    }
                }
            }
        </nav>
        <div class="fp-foot">Stufe 2 · Iteration 8<br />Entwicklungsstand, Mock-Anbindungen<br /><a href="impressum">Impressum</a></div>
    </aside>
    <div class="fp-main">
        <div class="fp-streifen" aria-hidden="true"></div>
        <header class="fp-top">
            <form method="get" action="suche" class="fp-inline fp-kopfsuche" role="search">
                <input name="q" type="search" class="fp-input" placeholder="Suchen … (Strg+K)" aria-label="Alles durchsuchen: Personen, Termine, Anträge, Funktionen (Strg+K)" aria-keyshortcuts="Control+K" />
            </form>
            <a class="fp-link" href="handy" title="Schlanke Handy-Ansicht (statisch, schnell bei schlechtem Netz)">Handy-Ansicht</a>
            <AuthorizeView>
                <Authorized>
                    <span data-angemeldet hidden></span>
                    <div class="fp-role">
                        <span>Angemeldet als <b>@benutzer?.Name</b></span>
                        @if (benutzer is { Rollen.Count: > 1 })
                        {
                            <form method="post" action="rolle-wechseln" class="fp-inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="zurueck" value="@AktuellerPfad" />
                                <label for="rolle-wahl">Rolle</label>
                                <select id="rolle-wahl" name="rolle" class="fp-select" data-auto-absenden
                                        title="Aktive Rolle wechseln: Aufgaben und Rechte richten sich nach ihr.">
                                    @foreach (var r in benutzer.Rollen)
                                    {
                                        <option value="@r" selected="@(r == benutzer.Rolle)">@r.Anzeigename()</option>
                                    }
                                </select>
                                <noscript><button type="submit" class="fp-linkbutton">wechseln</button></noscript>
                            </form>
                        }
                        else
                        {
                            <span class="fp-why" tabindex="0" data-why="Diesem Konto ist nur diese eine Rolle zugeordnet.">Rolle <b>@benutzer?.Rolle?.Anzeigename()</b></span>
                        }
                        <a href="hilfe" class="fp-link" title="Bedienung, Abläufe Schritt für Schritt, geführte Touren">Hilfe</a>
                        <a href="einstellungen" class="fp-link" title="Persönliche Ansprache (Du/Sie, Begrüßung)">Einstellungen</a>
                        <a href="anmelden" class="fp-link" title="Mit einem anderen Testkonto anmelden">Konto wechseln</a>
                        <form method="post" action="abmelden" class="fp-inline">
                            <AntiforgeryToken />
                            <button type="submit" class="fp-linkbutton">Abmelden</button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
            @if (Betriebsart.IstUebung)
            {
                <span class="fp-proto fp-uebung" title="Übungsinstanz mit Demodaten: Hier darf alles ausprobiert werden, Mails gehen nicht hinaus, die Daten werden zurückgesetzt.">Übungsinstanz · Demodaten</span>
            }
            else
            {
                <span class="fp-proto" title="Alle Mails und Push-Mitteilungen werden nur simuliert; nichts verlässt das System. Das RIS ist ein Mock.">Entwicklung · Mock-Anbindungen</span>
            }
        </header>
        <main class="fp-content">
            @if (Gesperrt() is { } sperre)
            {
                @* Direkte Adresse zu einem Bereich, den das Menü für diese Rolle sperrt: erklären statt leere Seite *@
                <section class="fp-card" role="alert">
                    <h1>@sperre.Titel ist für diese Rolle gesperrt</h1>
                    <p>@sperre.Grund</p>
                    <p><a href="">Zur Startseite</a></p>
                </section>
            }
            else
            {
                @* Fehler in einer Seite beenden nicht die ganze Sitzung: verständliche Meldung, neu laden hilft *@
                <ErrorBoundary @ref="fehlergrenze">
                    <ChildContent>@Body</ChildContent>
                    <ErrorContent>
                        <section class="fp-card" role="alert">
                            <h1>Da ist etwas schiefgelaufen</h1>
                            <p>Diese Seite konnte die Eingabe nicht verarbeiten. Bitte die Seite neu laden; die übrigen Daten sind nicht betroffen.</p>
                            <p><a href="" onclick="location.reload(); return false;">Seite neu laden</a></p>
                        </section>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Es ist ein unerwarteter Fehler aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? fehlergrenze;

    protected override void OnParametersSet() => fehlergrenze?.Recover();   // nach Seitenwechsel wieder normal anzeigen

    private sealed record Navigationspunkt(string Gruppe, string Titel, string Ziel, Func<Rolle?, Freigabe>? Recht = null, string? Geplant = null);

    private static readonly IReadOnlyList<Navigationspunkt> Navigationspunkte =
    [
        new("Übersicht", "Heute", ""),
        new("Übersicht", "Kalender", "kalender"),
        new("Übersicht", "Hilfe", "hilfe"),
        new("Übersicht", "Aufgaben", "aufgaben", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Sitzungen", "Abwesenheit melden", "abwesenheit", Rechte.AbwesenheitMelden),
        new("Sitzungen", "Offene Vertretungen", "vertretungen", r => r is Rolle.Helferin ? Freigabe.Nein("Nur für Mitglieder, sachkundige Bürger:innen, Vorstand und Administration.") : Freigabe.Ja),
        new("Sitzungen", "Anträge", "antraege", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Sitzungen", "Abstimmungen und Umfragen", "abstimmungen", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Sitzungen", "Wahlen und Ämter", "wahlen", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Sitzungen", "Sitzungen und Protokolle", "sitzungen", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Fraktion", "Gremien und Mandate", "gremien", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur Kampagnen und öffentliche Termine.") : Freigabe.Ja),
        new("Fraktion", "Personen", "personen", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur Kampagnen und öffentliche Termine.") : Freigabe.Ja),
        new("Fraktion", "Räume und Ressourcen", "ressourcen"),
        new("Fraktion", "Terminbesetzung", "besetzung", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Politik", "Anfragen an die Verwaltung", "anfragen", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Politik", "Beschlusslage", "beschluesse", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Politik", "Bürgeranliegen", "anliegen", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Politik", "Pressearbeit", "presse", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Politik", "Kontakte", "kontakte", r => r is Rolle.Helferin ? Freigabe.Nein("Das Kampagnenteam sieht nur die Kampagnen.") : Freigabe.Ja),
        new("Wissen", "Wiki", "wiki"),
        new("Wissen", "Dateien", "dateien"),
        new("Kampagnen", "Kampagnen", "kampagnen"),
        new("Finanzen", "Kasse und Budget", "finanzen", Rechte.FinanzenEinsehen),
        new("Finanzen", "Meine Auslagen", "auslagen"),
        new("Persönlich", "Kalender-Abo und Push", "kalender-abo"),
        new("Verwaltung", "Postausgang", "postausgang", Rechte.VerwaltungEinsehen),
        new("Verwaltung", "Protokoll", "protokoll", Rechte.VerwaltungEinsehen),
        new("Verwaltung", "Betrieb und Sicherung", "betrieb", Rechte.BetriebSteuern),
        new("Verwaltung", "Dokumentation", "dokumentation", Rechte.DokumentationKommentieren),
    ];

    [CascadingParameter]
    private Task<AuthenticationState>? Anmeldung { get; set; }

    private Benutzer? benutzer;

    private string AktuellerPfad => Navigation.ToBaseRelativePath(Navigation.Uri);

    /// <summary>Gesperrter Menüpunkt, zu dem die aktuelle Adresse gehört (gleiche Regel wie im Menü).</summary>
    private (string Titel, string Grund)? Gesperrt()
    {
        var pfad = AktuellerPfad.Split('?', '#')[0];
        foreach (var n in Navigationspunkte.Where(n => n.Recht is not null && n.Ziel.Length > 0))
        {
            if ((pfad == n.Ziel || pfad.StartsWith(n.Ziel + "/", StringComparison.OrdinalIgnoreCase)) && n.Recht!(benutzer?.Rolle) is { Erlaubt: false } nein)
            {
                return (n.Titel, nein.Begruendung ?? "Für diese Rolle nicht freigegeben.");
            }
        }

        return null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Anmeldung is not null)
        {
            benutzer = FraktionPerfekt.Adapters.Mocks.MockAnmeldung.AlsBenutzer((await Anmeldung).User);
        }
    }

    private string? Gesperrt(Navigationspunkt punkt)
    {
        if (punkt.Geplant is { } stufe)
        {
            return Freigabe.Geplant(punkt.Titel, stufe).Begruendung;
        }

        return punkt.Recht?.Invoke(benutzer?.Rolle) is { Erlaubt: false } nein ? nein.Begruendung : null;
    }
}
