<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF" />
    <BasePath />
    <ResourcePreloader />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" href="marke/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="marke/icon-192.png" />
    <RadzenTheme Theme="standard" />
    <link rel="stylesheet" href="lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="lib/toastui-editor/toastui-editor.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FraktionPerfekt.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="SeitenModus" />
</head>

<body>
    <Routes @rendermode="SeitenModus" />
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
    <script src="@Assets["verhalten.js"]"></script>
    <script src="@Assets["suche.js"]"></script>
    <script src="@Assets["tour.js"]"></script>
    <script src="lib/leaflet/leaflet.js"></script>
    <script src="@Assets["karte.js"]"></script>
    <script src="lib/toastui-editor/toastui-editor-all.min.js"></script>
    <script src="@Assets["editor.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Seiten mit [ExcludeFromInteractiveRouting] (Anmeldung, Handy-Seiten) laufen statisch, alle anderen interaktiv.
    private IComponentRenderMode? SeitenModus => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
