@*
    Nicht editierbares Feld mit Schloss-Symbol. Der Tooltip erklärt, warum es nicht änderbar ist
    und – wenn möglich – wie man es stattdessen ändert.
*@
<div class="fp-field">
    <span class="fp-lbl">@Bezeichnung</span>
    <span class="fp-why fp-lock" tabindex="0" data-why="@Begruendung" aria-label="@($"{Bezeichnung}: {Wert}. Nicht änderbar: {Begruendung}")">
        <span class="fp-val fp-ro">
            <span>@Wert</span>
            <RadzenIcon Icon="lock" class="fp-lockicon" />
        </span>
    </span>
</div>

@code {
    [Parameter, EditorRequired]
    public string Bezeichnung { get; set; } = string.Empty;

    [Parameter]
    public string? Wert { get; set; }

    [Parameter, EditorRequired]
    public string Begruendung { get; set; } = string.Empty;
}
