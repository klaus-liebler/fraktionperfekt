@using System.Text.RegularExpressions
@using Markdig
@using Markdig.Syntax
@using Markdig.Syntax.Inlines

@* Markdown mit Markdig (Tabellen, Listen, Zitate, Code, Bilder, Links, [[Wiki-Links]]).
   Bereinigung: Roh-HTML wird nie übernommen (DisableHtml → als Text kodiert), Links nur http/https/mailto oder relativ,
   Bilder nur aus der eigenen Bildablage (dateien/bild/…). Überschriften rücken eine Ebene ein (# → h2), weil die Seite h1 hat. *@
<div class="fp-markdown">@((MarkupString)Html(Text, WikiBasis))</div>

@code {
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Basisadresse für [[Wiki-Links]] (z. B. „wiki/seite/“).</summary>
    [Parameter]
    public string WikiBasis { get; set; } = "wiki/seite/";

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .DisableHtml().UsePipeTables().UseEmphasisExtras().UseTaskLists().UseAutoLinks().UseSoftlineBreakAsHardlineBreak().Build();

    /// <summary>Markdown → sicheres HTML (öffentlich für Tests).</summary>
    public static string Html(string? text, string wikiBasis = "wiki/seite/")
    {
        var quelle = Regex.Replace(text ?? string.Empty, @"\[\[([^\[\]\n]+?)\]\]",
            m => $"[{m.Groups[1].Value.Replace("]", "\\]")}]({wikiBasis}{Uri.EscapeDataString(m.Groups[1].Value)})", RegexOptions.None, TimeSpan.FromSeconds(1));
        var dokument = Markdig.Markdown.Parse(quelle, Pipeline);
        foreach (var link in dokument.Descendants<LinkInline>())
        {
            if (!SichereAdresse(link.Url, link.IsImage))
            {
                link.Url = link.IsImage ? string.Empty : "#";
            }
        }

        foreach (var auto in dokument.Descendants<AutolinkInline>())
        {
            if (!SichereAdresse(auto.Url, false))
            {
                auto.Url = "#";
            }
        }

        foreach (var h in dokument.Descendants<HeadingBlock>())
        {
            h.Level = Math.Min(6, h.Level + 1);
        }

        return dokument.ToHtml(Pipeline);
    }

    /// <summary>Links: http, https, mailto oder relativ (ohne Schema, nicht „//“). Bilder: nur „dateien/bild/{Guid}“.</summary>
    public static bool SichereAdresse(string? url, bool bild)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return false;
        }

        var u = url.Trim();
        if (bild)
        {
            return Regex.IsMatch(u, @"^/?dateien/bild/[0-9a-fA-F-]{36}$", RegexOptions.None, TimeSpan.FromSeconds(1));
        }

        if (u.StartsWith("//", StringComparison.Ordinal) || u.StartsWith("\\\\", StringComparison.Ordinal))
        {
            return false;
        }

        var doppelpunkt = u.IndexOf(':', StringComparison.Ordinal);
        var ende = u.IndexOfAny(['/', '?', '#']);
        if (doppelpunkt < 0 || (ende >= 0 && ende < doppelpunkt))
        {
            return true; // relativ
        }

        var schema = u[..doppelpunkt].ToLowerInvariant();
        return schema is "http" or "https" or "mailto";
    }
}
